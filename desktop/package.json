{
  "name": "galla-desktop",
  "productName": "Galla",
  "version": "0.1.0",
  "description": "Galla inventory management: desktop app for macOS and Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "electron-builder --win nsis portable",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.galla.desktop",
    "productName": "Galla",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "build/icon.png",
      "app-config.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Galla-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Galla-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Galla-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Galla-portable-${arch}.${ext}"
    }
  }
}
