{
  "name": "galla-desktop",
  "productName": "Galla",
  "version": "0.1.1",
  "description": "Galla inventory management: desktop app for macOS and Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist": "electron-builder --mac --win",
    "dist:mac:unsigned": "electron-builder --mac dmg zip --x64 --arm64 -c.mac.identity=- -c.mac.notarize=false"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.galla.desktop",
    "productName": "Galla",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "offline.html",
      "app-config.json",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Galla-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Galla uses the camera to scan product barcodes.",
        "NSBluetoothAlwaysUsageDescription": "Galla connects to Bluetooth receipt printers and barcode scanners."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Galla-win-${arch}.${ext}",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": [
          "Concilio Solutions"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Galla-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Galla-portable-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sparsh-bit",
        "repo": "galla-releases",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
