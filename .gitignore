# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/.next-lan/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
/.data/
/uploads/
/test-results/
/playwright-report/

# macOS AppleDouble files (exFAT volumes)
._*

# local marketing & tmp assets
.galla_tmp/
galla-marketing/

# desktop app
/desktop/node_modules/
/desktop/dist/
/mobile/node_modules/
/mobile/ios/App/Pods/

# editor / agent / macOS junk
.claude/
.kilo/
.continue/
.galla_tmp/
._*
