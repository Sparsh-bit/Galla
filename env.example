# Copy to .env.local and fill in.
# MongoDB must be a replica set (Atlas is by default; locally run `npm run db`)
MONGODB_URI=mongodb://127.0.0.1:27017/galla?replicaSet=rs0
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the app (https in production — camera scanning requires HTTPS)
APP_URL=http://localhost:3000
# Outgoing mail: a Resend API key (re_..., recommended; works on Railway) ...
RESEND_API_KEY=
# ... or SMTP, e.g. smtps://user:pass@smtp.example.com:465 . Unset = links are printed to the server log.
SMTP_URL=
MAIL_FROM=Galla <no-reply@example.com>
# Where uploaded product images are stored
UPLOAD_DIR=./uploads
# Optional: separate key for encrypting stored GST API credentials (32+ chars)
ENCRYPTION_KEY=
# Optional: extra hosts allowed for the GST e-invoice API (e.g. your GSP), comma separated
NIC_EXTRA_HOSTS=
# Optional: Google Play link for the Android app (shown on /download)
ANDROID_APP_URL=
# Optional: oldest app versions allowed to use the API (older apps are asked to update), e.g. 1.0.0
MIN_ANDROID_VERSION=
MIN_IOS_VERSION=
MIN_DESKTOP_VERSION=
# Optional: contact address shown on /privacy and /account-deletion
SUPPORT_EMAIL=
